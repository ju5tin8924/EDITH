{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "EDITH_SUPER_SECURE_ENTERPRISE_AML_JWT_SECRET_KEY_2026_GCC_VALIDATION_STRING",
    "Issuer": "https://edith.aml.cloud",
    "Audience": "https://edith.aml.cloud"
  },
  "ReverseProxy": {
    "Routes": {
      "screening-route": {
        "ClusterId": "screening-cluster",
        "AuthorizationPolicy": "AuthenticatedTenant",
        "Match": {
          "Path": "/api/v1/screen/{**catch-all}"
        }
      },
      "whitelists-route": {
        "ClusterId": "screening-cluster",
        "AuthorizationPolicy": "AuthenticatedTenant",
        "Match": {
          "Path": "/api/v1/whitelists/{**catch-all}"
        }
      },
      "watchlist-sync-route": {
        "ClusterId": "screening-cluster",
        "AuthorizationPolicy": "AuthenticatedTenant",
        "Match": {
          "Path": "/api/v1/watchlist/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "screening-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5101"
          }
        }
      }
    }
  }
}
